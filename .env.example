# Supabase client keys for frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails granted admin only on first profile create (optional bootstrap)
VITE_ADMIN_EMAILS=you@example.com

# Supabase admin key for backend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co

# Gemini / Google GenAI API key for backend AI endpoint
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Optional Firebase admin service account JSON path
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# LinkedIn OAuth legacy flow (if used)
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_REDIRECT_URI=https://your-app.com/api/auth/linkedin/callback
