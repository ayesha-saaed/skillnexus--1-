rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() { 
      return request.auth != null && (request.auth.token.email_verified == true || request.auth.token.email == 'saeedayesha995@gmail.com'); 
    }
    
    function isSystemOwner() {
      return request.auth.token.email == 'saeedayesha995@gmail.com';
    }

    function isAdmin() { 
      // Identity-based admin check
      return isSignedIn() && (
        isSystemOwner() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    
    // --- 0. MASTER OVERRIDE FOR OWNER ---
    // This ensures the primary developer/owner is never blocked during bootstrap or testing.
    match /{document=**} {
      allow read, write: if isSignedIn() && isSystemOwner();
    }

    // --- 1. USERS ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) || isAdmin());
      
      // User Skills Sub-collection
      match /skills/{skillId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // --- 2. METADATA COLLECTIONS (Global Read) ---
    match /resources/{id} {
      allow read: if true;
      allow write: if isAdmin() || !isSignedIn(); // Allow server-side bootstrap
    }

    match /jobRoles/{id} {
      allow read: if true;
      allow write: if isAdmin() || !isSignedIn(); // Allow server-side bootstrap
    }

    match /skills/{id} {
      allow read: if true;
      allow write: if isAdmin() || !isSignedIn(); // Allow server-side bootstrap
    }

    match /industryDemand/{id} {
      allow read: if true;
      allow write: if isAdmin() || !isSignedIn(); // Allow server-side bootstrap
    }

    match /trends/{id} {
      allow read: if true;
      allow write: if isAdmin() || !isSignedIn(); // Allow server-side bootstrap
    }

    match /recommendations/{id} {
      allow read: if isAuthenticated(); // Global read for authenticated users
      allow write: if isAdmin();
    }

    // --- 3. USER PROGRESS (Secure List) ---
    match /progress/{id} {
      // List rule must be simple to enable query filtering
      allow list: if isAuthenticated(); 
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && incoming().userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // --- 4. SYSTEM COLLECTIONS ---
    match /test/{id} {
      allow read, write: if true;
    }
  }
}
